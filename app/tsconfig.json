{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "shaping": [
        "../packages/shaping/src/index.ts"
      ],
      "shaping/*": [
        "../packages/shaping/src/*/index.ts"
      ],
      "previz": [
        "../vendor/previz/dist/index.d.ts"
      ],
      "previz/*": [
        "../vendor/previz/dist/*/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
